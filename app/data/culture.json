  {
    "id": "jing-ye-si", "kind": "poem", "title": "静夜思", "pinyinTitle": "Jìng yè sī", "englishTitle": "Quiet Night Thoughts", "creator": "李白 · Li Bai", "period": "Tang dynasty",
    "lines": [
      {"hanzi":"床前明月光","pinyin":"Chuáng qián míng yuè guāng","english":"Bright moonlight before my bed."},
      {"hanzi":"疑是地上霜","pinyin":"Yí shì dì shàng shuāng","english":"I wonder if it is frost on the ground."},
      {"hanzi":"举头望明月","pinyin":"Jǔ tóu wàng míng yuè","english":"I raise my head and gaze at the bright moon."},
      {"hanzi":"低头思故乡","pinyin":"Dī tóu sī gùxiāng","english":"I lower my head and think of home."}
    ],
    "vocabulary": [
