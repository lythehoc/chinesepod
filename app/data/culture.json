  {"id":"lu-zhai","kind":"poem","title":"鹿柴","pinyinTitle":"Lù zhài","englishTitle":"Deer Enclosure","creator":"王维 · Wang Wei","period":"Tang dynasty","lines":[{"hanzi":"空山不见人","pinyin":"Kōng shān bú jiàn rén","english":"In the empty mountains, no one is seen."},{"hanzi":"但闻人语响","pinyin":"Dàn wén rén yǔ xiǎng","english":"Yet voices can be heard."},{"hanzi":"返景入深林","pinyin":"Fǎn yǐng rù shēn lín","english":"The returning sunlight enters the deep forest."},{"hanzi":"复照青苔上","pinyin":"Fù zhào qīngtái shàng","english":"And shines again upon the green moss."}],"vocabulary":[{"hanzi":"空山","pinyin":"kōng shān","english":"empty mountain"},{"hanzi":"人语","pinyin":"rén yǔ","english":"human voices"},{"hanzi":"深林","pinyin":"shēn lín","english":"deep forest"},{"hanzi":"青苔","pinyin":"qīngtái","english":"green moss"}]},
  {"id":"zhu-li-guan","kind":"poem","title":"竹里馆","pinyinTitle":"Zhú lǐ guǎn","englishTitle":"Bamboo Lodge","creator":"王维 · Wang Wei","period":"Tang dynasty","lines":[{"hanzi":"独坐幽篁里","pinyin":"Dú zuò yōu huáng lǐ","english":"Alone I sit among secluded bamboo."},{"hanzi":"弹琴复长啸","pinyin":"Tán qín fù cháng xiào","english":"I play the zither and whistle long."},{"hanzi":"深林人不知","pinyin":"Shēn lín rén bù zhī","english":"Deep in the forest, no one knows."},{"hanzi":"明月来相照","pinyin":"Míng yuè lái xiāng zhào","english":"Only the bright moon comes to shine on me."}],"vocabulary":[{"hanzi":"独坐","pinyin":"dú zuò","english":"sit alone"},{"hanzi":"幽篁","pinyin":"yōu huáng","english":"secluded bamboo"},{"hanzi":"弹琴","pinyin":"tán qín","english":"play the zither"},{"hanzi":"明月","pinyin":"míngyuè","english":"bright moon"}]},
  {"id":"niao-ming-jian","kind":"poem","title":"鸟鸣涧","pinyinTitle":"Niǎo míng jiàn","englishTitle":"Birdsong Stream","creator":"王维 · Wang Wei","period":"Tang dynasty","lines":[{"hanzi":"人闲桂花落","pinyin":"Rén xián guìhuā luò","english":"At ease, I notice osmanthus flowers falling."},{"hanzi":"夜静春山空","pinyin":"Yè jìng chūn shān kōng","english":"The spring mountain is empty in the quiet night."},{"hanzi":"月出惊山鸟","pinyin":"Yuè chū jīng shān niǎo","english":"The rising moon startles the mountain birds."},{"hanzi":"时鸣春涧中","pinyin":"Shí míng chūn jiàn zhōng","english":"Now and then they call in the spring ravine."}],"vocabulary":[{"hanzi":"桂花","pinyin":"guìhuā","english":"osmanthus flower"},{"hanzi":"夜静","pinyin":"yè jìng","english":"quiet night"},{"hanzi":"月出","pinyin":"yuè chū","english":"moonrise"},{"hanzi":"山鸟","pinyin":"shān niǎo","english":"mountain bird"}]},
  {"id":"jue-ju","kind":"poem","title":"绝句","pinyinTitle":"Juéjù","englishTitle":"Quatrain","creator":"杜甫 · Du Fu","period":"Tang dynasty","lines":[{"hanzi":"两个黄鹂鸣翠柳","pinyin":"Liǎng gè huánglí míng cuì liǔ","english":"Two orioles sing among green willows."},{"hanzi":"一行白鹭上青天","pinyin":"Yì háng báilù shàng qīngtiān","english":"A line of egrets rises into the blue sky."},{"hanzi":"窗含西岭千秋雪","pinyin":"Chuāng hán Xī Lǐng qiān qiū xuě","english":"The window frames a thousand years of western snow."},{"hanzi":"门泊东吴万里船","pinyin":"Mén bó Dōng Wú wàn lǐ chuán","english":"At the gate, boats from distant Eastern Wu are moored."}],"vocabulary":[{"hanzi":"黄鹂","pinyin":"huánglí","english":"oriole"},{"hanzi":"白鹭","pinyin":"báilù","english":"egret"},{"hanzi":"青天","pinyin":"qīngtiān","english":"blue sky"},{"hanzi":"千秋雪","pinyin":"qiān qiū xuě","english":"ancient snow"}]},
  {"id":"wang-lu-shan-pu-bu","kind":"poem","title":"望庐山瀑布","pinyinTitle":"Wàng Lúshān pùbù","englishTitle":"Viewing the Lushan Waterfall","creator":"李白 · Li Bai","period":"Tang dynasty","lines":[{"hanzi":"日照香炉生紫烟","pinyin":"Rì zhào Xiānglú shēng zǐ yān","english":"Sunlight on Incense Burner Peak raises violet mist."},{"hanzi":"遥看瀑布挂前川","pinyin":"Yáo kàn pùbù guà qián chuān","english":"From afar, the waterfall hangs before the river."},{"hanzi":"飞流直下三千尺","pinyin":"Fēi liú zhí xià sān qiān chǐ","english":"Its flying stream plunges three thousand feet."},{"hanzi":"疑是银河落九天","pinyin":"Yí shì Yínhé luò jiǔ tiān","english":"It seems the Milky Way has fallen from heaven."}],"vocabulary":[{"hanzi":"日照","pinyin":"rì zhào","english":"sunlight"},{"hanzi":"瀑布","pinyin":"pùbù","english":"waterfall"},{"hanzi":"飞流","pinyin":"fēi liú","english":"flying stream"},{"hanzi":"银河","pinyin":"Yínhé","english":"Milky Way"}]},
  {"id":"qing-ming","kind":"poem","title":"清明","pinyinTitle":"Qīngmíng","englishTitle":"Qingming","creator":"杜牧 · Du Mu","period":"Tang dynasty","lines":[{"hanzi":"清明时节雨纷纷","pinyin":"Qīngmíng shíjié yǔ fēnfēn","english":"Drizzle falls throughout the Qingming season."},{"hanzi":"路上行人欲断魂","pinyin":"Lù shàng xíngrén yù duàn hún","english":"Travelers on the road are overcome with sorrow."},{"hanzi":"借问酒家何处有","pinyin":"Jièwèn jiǔjiā hé chù yǒu","english":"May I ask where an inn can be found?"},{"hanzi":"牧童遥指杏花村","pinyin":"Mùtóng yáo zhǐ Xìnghuā Cūn","english":"A shepherd boy points toward Apricot Blossom Village."}],"vocabulary":[{"hanzi":"清明","pinyin":"Qīngmíng","english":"Qingming Festival"},{"hanzi":"行人","pinyin":"xíngrén","english":"traveler"},{"hanzi":"借问","pinyin":"jièwèn","english":"may I ask"},{"hanzi":"牧童","pinyin":"mùtóng","english":"shepherd boy"}]},
  {"id":"shan-xing","kind":"poem","title":"山行","pinyinTitle":"Shān xíng","englishTitle":"Mountain Journey","creator":"杜牧 · Du Mu","period":"Tang dynasty","lines":[{"hanzi":"远上寒山石径斜","pinyin":"Yuǎn shàng hán shān shí jìng xié","english":"Far up the cold mountain, a stone path winds."},{"hanzi":"白云生处有人家","pinyin":"Bái yún shēng chù yǒu rén jiā","english":"Where white clouds rise, there are homes."},{"hanzi":"停车坐爱枫林晚","pinyin":"Tíng chē zuò ài fēng lín wǎn","english":"I stop the carriage, charmed by the evening maples."},{"hanzi":"霜叶红于二月花","pinyin":"Shuāng yè hóng yú èr yuè huā","english":"Frosted leaves are redder than spring flowers."}],"vocabulary":[{"hanzi":"石径","pinyin":"shí jìng","english":"stone path"},{"hanzi":"白云","pinyin":"bái yún","english":"white clouds"},{"hanzi":"枫林","pinyin":"fēng lín","english":"maple forest"},{"hanzi":"霜叶","pinyin":"shuāng yè","english":"frosted leaves"}]},
  {"id":"xun-yin-zhe-bu-yu","kind":"poem","title":"寻隐者不遇","pinyinTitle":"Xún yǐnzhě bú yù","englishTitle":"Seeking the Hermit","creator":"贾岛 · Jia Dao","period":"Tang dynasty","lines":[{"hanzi":"松下问童子","pinyin":"Sōng xià wèn tóngzǐ","english":"Beneath the pine, I ask the boy."},{"hanzi":"言师采药去","pinyin":"Yán shī cǎi yào qù","english":"He says his master went to gather herbs."},{"hanzi":"只在此山中","pinyin":"Zhǐ zài cǐ shān zhōng","english":"He is somewhere on this mountain."},{"hanzi":"云深不知处","pinyin":"Yún shēn bù zhī chù","english":"Deep in the clouds, no one knows where."}],"vocabulary":[{"hanzi":"松下","pinyin":"sōng xià","english":"beneath the pine"},{"hanzi":"童子","pinyin":"tóngzǐ","english":"young boy"},{"hanzi":"采药","pinyin":"cǎi yào","english":"gather herbs"},{"hanzi":"云深","pinyin":"yún shēn","english":"deep in clouds"}]},
  {"id":"hui-xiang-ou-shu","kind":"poem","title":"回乡偶书","pinyinTitle":"Huí xiāng ǒu shū","englishTitle":"Returning Home","creator":"贺知章 · He Zhizhang","period":"Tang dynasty","lines":[{"hanzi":"少小离家老大回","pinyin":"Shào xiǎo lí jiā lǎo dà huí","english":"I left home young and return an old man."},{"hanzi":"乡音无改鬓毛衰","pinyin":"Xiāngyīn wú gǎi bìn máo shuāi","english":"My accent is unchanged, though my hair has thinned."},{"hanzi":"儿童相见不相识","pinyin":"Értóng xiāng jiàn bù xiāng shí","english":"Children see me but do not recognize me."},{"hanzi":"笑问客从何处来","pinyin":"Xiào wèn kè cóng hé chù lái","english":"Smiling, they ask where this guest came from."}],"vocabulary":[{"hanzi":"离家","pinyin":"lí jiā","english":"leave home"},{"hanzi":"乡音","pinyin":"xiāngyīn","english":"hometown accent"},{"hanzi":"儿童","pinyin":"értóng","english":"children"},{"hanzi":"何处","pinyin":"hé chù","english":"where"}]},
  {"id":"zeng-wang-lun","kind":"poem","title":"赠汪伦","pinyinTitle":"Zèng Wāng Lún","englishTitle":"For Wang Lun","creator":"李白 · Li Bai","period":"Tang dynasty","lines":[{"hanzi":"李白乘舟将欲行","pinyin":"Lǐ Bái chéng zhōu jiāng yù xíng","english":"Li Bai boards his boat, about to depart."},{"hanzi":"忽闻岸上踏歌声","pinyin":"Hū wén àn shàng tà gē shēng","english":"Suddenly, singing and footsteps sound from shore."},{"hanzi":"桃花潭水深千尺","pinyin":"Táohuā Tán shuǐ shēn qiān chǐ","english":"Peach Blossom Pool may be a thousand feet deep."},{"hanzi":"不及汪伦送我情","pinyin":"Bù jí Wāng Lún sòng wǒ qíng","english":"Yet it is not as deep as Wang Lun's friendship."}],"vocabulary":[{"hanzi":"乘舟","pinyin":"chéng zhōu","english":"travel by boat"},{"hanzi":"岸上","pinyin":"àn shàng","english":"on the shore"},{"hanzi":"潭水","pinyin":"tán shuǐ","english":"pool water"},{"hanzi":"送别","pinyin":"sòngbié","english":"see someone off"}]},
  {"id":"guang-nian-zhi-wai","kind":"song","title":"光年之外","pinyinTitle":"Guāngnián zhī wài","englishTitle":"Light Years Away","creator":"邓紫棋 · G.E.M.","period":"Mandopop · 2016","videoId":"T4SimnaiktU","lines":[{"hanzi":"光年之外","pinyin":"guāngnián zhī wài","english":"light years away"},{"hanzi":"宇宙","pinyin":"yǔzhòu","english":"universe"},{"hanzi":"等待","pinyin":"děngdài","english":"to wait"},{"hanzi":"即使距离很远，我也愿意耐心等待","pinyin":"Jíshǐ jùlí hěn yuǎn, wǒ yě yuànyì nàixīn děngdài","english":"Even if the distance is great, I am willing to wait patiently."}],"vocabulary":[{"hanzi":"光年","pinyin":"guāngnián","english":"light-year"},{"hanzi":"距离","pinyin":"jùlí","english":"distance"},{"hanzi":"宇宙","pinyin":"yǔzhòu","english":"universe"},{"hanzi":"等待","pinyin":"děngdài","english":"wait"}]},
  {"id":"ke-zai-xin-di","kind":"song","title":"刻在我心底的名字","pinyinTitle":"Kè zài wǒ xīndǐ de míngzi","englishTitle":"Your Name Engraved Herein","creator":"卢广仲 · Crowd Lu","period":"Mandopop · 2020","videoId":"m78lJuzftcc","lines":[{"hanzi":"心底","pinyin":"xīndǐ","english":"deep in one's heart"},{"hanzi":"名字","pinyin":"míngzi","english":"name"},{"hanzi":"回忆","pinyin":"huíyì","english":"memory"},{"hanzi":"有些名字会一直留在我们的心里","pinyin":"Yǒuxiē míngzi huì yìzhí liú zài wǒmen de xīnli","english":"Some names remain in our hearts forever."}],"vocabulary":[{"hanzi":"刻下","pinyin":"kèxià","english":"engrave"},{"hanzi":"心底","pinyin":"xīndǐ","english":"bottom of the heart"},{"hanzi":"回忆","pinyin":"huíyì","english":"memory"},{"hanzi":"永远","pinyin":"yǒngyuǎn","english":"forever"}]},
  {"id":"xiang-jian-ni","kind":"song","title":"想见你想见你想见你","pinyinTitle":"Xiǎng jiàn nǐ","englishTitle":"Miss You 3000","creator":"八三夭 · 831","period":"Mandopop · 2019","videoId":"Zh7gmg8VjFc","lines":[{"hanzi":"想见你","pinyin":"xiǎng jiàn nǐ","english":"want to see you"},{"hanzi":"未来","pinyin":"wèilái","english":"future"},{"hanzi":"过去","pinyin":"guòqù","english":"past"},{"hanzi":"无论未来怎样，我都希望再次见到你","pinyin":"Wúlùn wèilái zěnyàng, wǒ dōu xīwàng zàicì jiàndào nǐ","english":"Whatever the future brings, I hope to see you again."}],"vocabulary":[{"hanzi":"想念","pinyin":"xiǎngniàn","english":"miss someone"},{"hanzi":"未来","pinyin":"wèilái","english":"future"},{"hanzi":"过去","pinyin":"guòqù","english":"past"},{"hanzi":"再次","pinyin":"zàicì","english":"again"}]},
  {"id":"ni-hao-bu-hao","kind":"song","title":"你，好不好？","pinyinTitle":"Nǐ, hǎo bù hǎo?","englishTitle":"How Have You Been?","creator":"周兴哲 · Eric Chou","period":"Mandopop · 2016","videoId":"wSBXfzgqHtE","lines":[{"hanzi":"好不好","pinyin":"hǎo bù hǎo","english":"how are things; is it okay"},{"hanzi":"关心","pinyin":"guānxīn","english":"care about"},{"hanzi":"目标","pinyin":"mùbiāo","english":"goal"},{"hanzi":"很久没见了，我想知道你好不好","pinyin":"Hěn jiǔ méi jiàn le, wǒ xiǎng zhīdào nǐ hǎo bù hǎo","english":"We have not met for a long time; I wonder how you are."}],"vocabulary":[{"hanzi":"最近","pinyin":"zuìjìn","english":"recently"},{"hanzi":"关心","pinyin":"guānxīn","english":"care about"},{"hanzi":"目标","pinyin":"mùbiāo","english":"goal"},{"hanzi":"联系","pinyin":"liánxì","english":"contact"}]},
  {"id":"gao-bai-qi-qiu","kind":"song","title":"告白气球","pinyinTitle":"Gàobái qìqiú","englishTitle":"Love Confession","creator":"周杰伦 · Jay Chou","period":"Mandopop · 2016","videoId":"bu7nU9Mhpyo","lines":[{"hanzi":"告白","pinyin":"gàobái","english":"confess one's feelings"},{"hanzi":"气球","pinyin":"qìqiú","english":"balloon"},{"hanzi":"浪漫","pinyin":"làngmàn","english":"romantic"},{"hanzi":"他准备了气球，勇敢地向喜欢的人告白","pinyin":"Tā zhǔnbèi le qìqiú, yǒnggǎn de xiàng xǐhuan de rén gàobái","english":"He prepared balloons and bravely confessed to the person he likes."}],"vocabulary":[{"hanzi":"告白","pinyin":"gàobái","english":"confession of love"},{"hanzi":"气球","pinyin":"qìqiú","english":"balloon"},{"hanzi":"浪漫","pinyin":"làngmàn","english":"romantic"},{"hanzi":"勇敢","pinyin":"yǒnggǎn","english":"brave"}]},
  {"id":"ti-mian","kind":"song","title":"体面","pinyinTitle":"Tǐmiàn","englishTitle":"Decency","creator":"于文文 · Kelly Yu","period":"Mandopop · 2017","videoId":"-kfVp3tqYvc","lines":[{"hanzi":"体面","pinyin":"tǐmiàn","english":"with dignity"},{"hanzi":"告别","pinyin":"gàobié","english":"say goodbye"},{"hanzi":"尊重","pinyin":"zūnzhòng","english":"respect"},{"hanzi":"即使故事结束，也应该体面地告别","pinyin":"Jíshǐ gùshi jiéshù, yě yīnggāi tǐmiàn de gàobié","english":"Even when a story ends, we should say goodbye with dignity."}],"vocabulary":[{"hanzi":"体面","pinyin":"tǐmiàn","english":"decent; dignified"},{"hanzi":"告别","pinyin":"gàobié","english":"say goodbye"},{"hanzi":"尊重","pinyin":"zūnzhòng","english":"respect"},{"hanzi":"结束","pinyin":"jiéshù","english":"end"}]},
  {"id":"ke-xi-mei-ru-guo","kind":"song","title":"可惜没如果","pinyinTitle":"Kěxī méi rúguǒ","englishTitle":"If Only","creator":"林俊杰 · JJ Lin","period":"Mandopop · 2014","videoId":"vsBf_0gDxSM","lines":[{"hanzi":"可惜","pinyin":"kěxī","english":"unfortunately; what a pity"},{"hanzi":"如果","pinyin":"rúguǒ","english":"if"},{"hanzi":"后悔","pinyin":"hòuhuǐ","english":"regret"},{"hanzi":"与其以后后悔，不如现在认真选择","pinyin":"Yǔqí yǐhòu hòuhuǐ, bùrú xiànzài rènzhēn xuǎnzé","english":"Instead of regretting it later, choose carefully now."}],"vocabulary":[{"hanzi":"可惜","pinyin":"kěxī","english":"what a pity"},{"hanzi":"如果","pinyin":"rúguǒ","english":"if"},{"hanzi":"后悔","pinyin":"hòuhuǐ","english":"regret"},{"hanzi":"选择","pinyin":"xuǎnzé","english":"choose"}]},
  {"id":"xiu-lian-ai-qing","kind":"song","title":"修炼爱情","pinyinTitle":"Xiūliàn àiqíng","englishTitle":"Practice Love","creator":"林俊杰 · JJ Lin","period":"Mandopop · 2013","videoId":"LWV-f6dMN3Q","lines":[{"hanzi":"修炼","pinyin":"xiūliàn","english":"practice and improve"},{"hanzi":"爱情","pinyin":"àiqíng","english":"romantic love"},{"hanzi":"成长","pinyin":"chéngzhǎng","english":"grow"},{"hanzi":"每一次经历都会帮助我们学习和成长","pinyin":"Měi yí cì jīnglì dōu huì bāngzhù wǒmen xuéxí hé chéngzhǎng","english":"Every experience helps us learn and grow."}],"vocabulary":[{"hanzi":"修炼","pinyin":"xiūliàn","english":"cultivate; practice"},{"hanzi":"爱情","pinyin":"àiqíng","english":"love"},{"hanzi":"经历","pinyin":"jīnglì","english":"experience"},{"hanzi":"成长","pinyin":"chéngzhǎng","english":"grow"}]},
